DATABASE_URL=postgresql://localhost:5432/evidence
APP_SECRET=replace-with-at-least-32-random-characters
PORT=3000
DATA_DIR=.data
# In production: set APP_URL to your HTTPS origin and COOKIE_SECURE=true.
APP_URL=http://127.0.0.1:3000
COOKIE_SECURE=false

# Vercel (separate values for Preview and Production; Node 22, iad1).
# DATABASE_URL=postgresql://...@ep-example-pooler.us-east-1.aws.neon.tech/evidence?sslmode=require
# DIRECT_DATABASE_URL=postgresql://...@ep-example.us-east-1.aws.neon.tech/evidence?sslmode=require
# DIRECT_DATABASE_URL is only needed by migration/restore CI, not runtime functions.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# JOB_RUNNER=workflow
# CRON_SECRET=independent-random-secret-at-least-32-characters
# COOKIE_SECURE=true
# APP_URL=https://your-app.example.com

# Billing: use Stripe sandbox credentials for local development and Preview.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_PORTAL_CONFIGURATION_ID=
# STRIPE_WEBHOOK_SECRET=
# Public business information, required before production sales.
# LEGAL_OPERATOR_NAME=
# SUPPORT_EMAIL=
# Offline operations only: 32 random bytes encoded as 64 hexadecimal characters.
# BACKUP_ENCRYPTION_KEY=

# Netlify Free alternative (Async Workloads extension must be enabled).
# STORAGE_PROVIDER=netlify
# JOB_RUNNER=netlify
# AWL_API_KEY=independent-random-secret-at-least-32-characters
# DEPLOY_ENV=production
# APP_URL=https://your-site.netlify.app
# Offline backup/restore only; never put these administrative credentials in runtime settings.
# NETLIFY_BLOBS_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
