{
  "name": "evidence-product-discovery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:all": "node scripts/dev.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('app/.well-known/workflow', { recursive: true, force: true })\"",
    "build": "next build --webpack && tsx scripts/pdf-package-smoke.ts",
    "start": "next start --hostname 0.0.0.0",
    "worker": "tsx scripts/worker.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit.test.ts tests/workflow.test.ts tests/groq-limits.test.ts tests/research.test.ts tests/discovery-experience.test.ts tests/netlify.test.ts tests/netlify-workflow.test.ts tests/deployment.test.mjs tests/api-request.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run typecheck && npm run test:unit && npm run test:ops && npm run test:e2e",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test:ops": "tsx --test tests/operations.test.ts tests/groq-limits-db.test.ts tests/analysis-db.test.ts tests/discovery-db.test.ts tests/commercial.test.ts tests/billing-db.test.ts tests/backup-crypto.test.mjs tests/health.test.mjs tests/netlify-db.test.ts",
    "format:check": "prettier --check app components lib/*.ts lib/workflows netlify scripts tests *.ts *.json README.md",
    "test:production": "tsx scripts/production-smoke.ts",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "test:hosted": "tsx scripts/hosted-smoke.ts",
    "backup:encrypted": "node scripts/secure-backup.mjs backup",
    "restore:encrypted": "node scripts/secure-backup.mjs restore",
    "metrics": "tsx scripts/launch-metrics.ts",
    "health": "node scripts/health-check.mjs",
    "test:stripe": "tsx scripts/stripe-smoke.ts",
    "test:netlify-package": "node scripts/netlify-package-smoke.mjs"
  },
  "dependencies": {
    "@netlify/async-workloads": "0.0.92",
    "@netlify/blobs": "^11.1.9",
    "@vercel/blob": "^2.8.2",
    "@zip.js/zip.js": "^2.24.0",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "pdf-parse": "2.4.5",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^23.1.0",
    "workflow": "^5.2.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "undici": "^7.30.1",
    "zod": "$zod",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.5",
    "@vercel/queue": {
      "minimatch": "^11.0.5"
    }
  }
}
